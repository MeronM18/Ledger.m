# Copy this file to .env.local and fill in the values.

# Plaid (https://dashboard.plaid.com/team/keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# Leave blank locally. In production, set to https://<your-vercel-domain>/api/plaid/webhook
PLAID_WEBHOOK_URL=

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The only email allowed to log in
ALLOWED_EMAIL=

# 32-byte AES-256-GCM key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ntfy.sh push notifications (https://ntfy.sh)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Random secret used to authenticate cron-triggered routes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# GoldAPI.io (https://www.goldapi.io/dashboard) — precious metal spot prices.
# Free tier: 100 requests/month, comfortably covers one fetch/day per metal.
GOLDAPI_KEY=
